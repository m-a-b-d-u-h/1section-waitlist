generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Waitlist {
  id        String   @id @default(uuid())
  googleId  String   @unique @map("google_id")
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlists")
}

model Feedback {
  id        String   @id @default(uuid())
  name      String?
  suggestion String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedbacks")
}
